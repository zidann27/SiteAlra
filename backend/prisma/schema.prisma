generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id        String   @id
  userId    String
  tokenHash String   @unique(map: "PasswordResetToken_tokenHash_key")
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordResetToken_userId_fkey")

  @@index([expiresAt], map: "PasswordResetToken_expiresAt_idx")
  @@index([userId], map: "PasswordResetToken_userId_idx")
  @@map("passwordresettoken")
}

model Product {
  id          String   @id
  siteId      String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade, map: "Product_siteId_fkey")

  @@index([isActive], map: "Product_isActive_idx")
  @@index([siteId], map: "Product_siteId_idx")
  @@map("product")
}

model Site {
  id                  String           @id
  businessName        String
  businessDescription String           @db.LongText
  category            String           @default("umum")
  slug                String           @unique(map: "Site_slug_key")
  aiContent           Json
  viewCount           Int              @default(0)
  ownerId             String?
  createdAt           DateTime         @default(now())
  products            Product[]
  owner               User?            @relation(fields: [ownerId], references: [id], map: "Site_ownerId_fkey")
  dailyVisits         SiteDailyVisit[]

  @@index([ownerId], map: "Site_ownerId_fkey")
  @@map("site")
}

model SiteDailyVisit {
  id        String   @id
  siteId    String
  visitDate DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade, map: "SiteDailyVisit_siteId_fkey")

  @@unique([siteId, visitDate], map: "SiteDailyVisit_siteId_visitDate_key")
  @@index([visitDate], map: "SiteDailyVisit_visitDate_idx")
  @@map("sitedailyvisit")
}

model User {
  id             String               @id
  email          String               @unique(map: "User_email_key")
  passwordHash   String?
  name           String?
  provider       String?              @default("local")
  providerId     String?
  createdAt      DateTime             @default(now())
  passwordResets PasswordResetToken[]
  sites          Site[]
  chatMessages   UserChatMessage[]
  chatThreads    UserChatThread[]
  products       UserProduct[]
  profile        UserProfile?

  @@unique([provider, providerId], map: "User_provider_providerId_key")
  @@index([provider], map: "User_provider_idx")
  @@map("user")
}

model UserChatMessage {
  id        String         @id
  userId    String
  role      String
  content   String         @db.LongText
  createdAt DateTime       @default(now())
  threadId  String
  thread    UserChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade, map: "UserChatMessage_threadId_fkey")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserChatMessage_userId_fkey")

  @@index([createdAt], map: "UserChatMessage_createdAt_idx")
  @@index([threadId], map: "UserChatMessage_threadId_idx")
  @@index([userId], map: "UserChatMessage_userId_idx")
  @@map("userchatmessage")
}

model UserChatThread {
  id        String            @id
  userId    String
  title     String            @default("Chat")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now())
  messages  UserChatMessage[]
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserChatThread_userId_fkey")

  @@index([updatedAt], map: "UserChatThread_updatedAt_idx")
  @@index([userId], map: "UserChatThread_userId_idx")
  @@map("userchatthread")
}

model UserProduct {
  id           String   @id
  userId       String
  name         String
  description  String   @default("")
  price        Decimal  @db.Decimal(12, 2)
  imageDataUrl String?  @db.LongText
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserProduct_userId_fkey")

  @@index([userId], map: "UserProduct_userId_idx")
  @@map("userproduct")
}

model UserProfile {
  id                  String   @id
  userId              String   @unique(map: "UserProfile_userId_key")
  name                String   @default("")
  businessType        String   @default("kuliner")
  shortDescription    String   @default("") @db.Text
  targetCustomers     String   @default("") @db.Text
  style               String   @default("modern")
  ownerEmail          String   @default("")
  phone               String   @default("")
  publicEmail         String   @default("")
  address             String   @default("") @db.Text
  hours               String   @default("") @db.Text
  domainName          String   @default("")
  logoDataUrl         String?  @db.LongText
  contentImageDataUrl String?  @db.LongText
  themeColor          String   @default("#2563eb")
  aiContent           Json?
  websiteActive       Boolean  @default(false)
  visitorTotal        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserProfile_userId_fkey")

  @@map("userprofile")
}
