generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  provider     String?  @default("local")
  providerId   String?
  createdAt    DateTime @default(now())

  sites        Site[]
  profile      UserProfile?
  products     UserProduct[]
  chatThreads  UserChatThread[]
  chatMessages UserChatMessage[]

  @@index([provider])
  @@unique([provider, providerId])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String   @default("")
  businessType     String   @default("kuliner")
  shortDescription String   @default("")
  targetCustomers  String   @default("")
  style            String   @default("modern")
  ownerEmail       String   @default("")
  phone            String   @default("")
  publicEmail      String   @default("")
  address          String   @default("")
  hours            String   @default("")
  domainName       String   @default("")
  logoDataUrl      String?  @db.LongText
  themeColor       String   @default("#2563eb")

  aiContent        Json?
  websiteActive    Boolean  @default(false)
  visitorTotal     Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserProduct {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  description  String   @default("")
  price        Decimal  @db.Decimal(12, 2)
  imageDataUrl String?  @db.LongText
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model UserChatThread {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String   @default("Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  UserChatMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model UserChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId  String
  thread    UserChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role      String
  content   String   @db.LongText
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([threadId])
  @@index([createdAt])
}

model Site {
  id                  String   @id @default(cuid())
  businessName        String
  businessDescription String
  category            String   @default("umum")
  slug                String   @unique
  aiContent           Json
  viewCount           Int      @default(0)
  ownerId             String?
  owner               User?    @relation(fields: [ownerId], references: [id])
  createdAt           DateTime @default(now())

  products            Product[]
}

model Product {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([siteId])
  @@index([isActive])
}
